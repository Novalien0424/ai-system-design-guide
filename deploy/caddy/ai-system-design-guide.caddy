# Vhost for the AI System Design Guide mirror — APPEND this block to the shared
# Caddyfile on HostHatch: /root/n8n-docker-caddy/caddy_config/Caddyfile
# Requires the web root mounted into the Caddy container (see deploy skill / DEPLOYMENT.md):
#   - /srv/ai-system-design-guide:/srv/ai-system-design-guide:ro
# Reload after editing: docker exec n8n-docker-caddy-caddy-1 caddy reload --config /etc/caddy/Caddyfile

ai-system-design-guide.novalien.com {
	root * /srv/ai-system-design-guide
	file_server
	try_files {path} {path}.html {path}/index.html

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Long-cache Material's content-fingerprinted build assets (e.g.
	# main.84d31ad4.min.css) — their URL changes on every edit, so a 1-year
	# immutable cache is safe. EXCLUDE our unhashed overlay assets, whose URLs
	# never change and so must stay revalidated.
	@immutable {
		path /assets/*
		not path /assets/slash.css /assets/mermaid-init.js
	}
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Short, revalidated cache for HTML and our unhashed overlay assets, so CSS/JS
	# fixes propagate in minutes rather than being pinned for a year. Exact paths +
	# globs avoid Caddyfile regex backslash/`{n,}`-placeholder escaping gotchas
	# (codex review P3).
	@shortlived path *.html */ /assets/slash.css /assets/mermaid-init.js
	header @shortlived Cache-Control "public, max-age=300, must-revalidate"

	log {
		output file /var/log/caddy/ai-system-design-guide.log
		format json
	}

	encode gzip zstd
}
