# Vhost for the AI System Design Guide mirror — APPEND this block to the shared
# Caddyfile on HostHatch: /root/n8n-docker-caddy/caddy_config/Caddyfile
# Requires the web root mounted into the Caddy container (see deploy skill / DEPLOYMENT.md):
#   - /srv/ai-system-design-guide:/srv/ai-system-design-guide:ro
# Reload after editing: docker exec n8n-docker-caddy-caddy-1 caddy reload --config /etc/caddy/Caddyfile

ai-system-design-guide.novalien.com {
	root * /srv/ai-system-design-guide
	file_server
	try_files {path} {path}.html {path}/index.html

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Immutable ONLY for content-fingerprinted build assets (e.g. main.84d31ad4.min.css).
	# A hash segment like ".84d31ad4." in the path is the fingerprint signal.
	@fingerprinted path_regexp \.[0-9a-f]{8,}\.
	header @fingerprinted Cache-Control "public, max-age=31536000, immutable"

	# Everything else — HTML and UNHASHED overlay assets (slash.css, mermaid-init.js) —
	# gets a short, revalidated cache so fixes propagate in minutes, not a year.
	@revalidate not path_regexp \.[0-9a-f]{8,}\.
	header @revalidate Cache-Control "public, max-age=300, must-revalidate"

	log {
		output file /var/log/caddy/ai-system-design-guide.log
		format json
	}

	encode gzip zstd
}
